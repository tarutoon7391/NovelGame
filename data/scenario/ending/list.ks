;=========================================
; エンディング一覧（タイトル画面から開く）
; 見たエンディングは sf.end1〜sf.end10 に記録されている（各エンディングの最後で記録）
;=========================================
*start
[cm]
[hidemenubutton]
[layopt layer="message0" visible="false"]
[bg storage="bg_white.png" time="300"]
[layopt layer="2" visible="true"]
[ptext layer="2" name="end_list" x="0" y="30" width="1280" align="center" size="40" color="0x222222" bold="true" text="エンディング一覧"]
[if exp="sf.end1"]
[ptext layer="2" name="end_list" x="240" y="110" size="28" color="0x222222" text="No.1 　TRUE END　疑って確かめる力を、身につけた"]
[else]
[ptext layer="2" name="end_list" x="240" y="110" size="28" color="0xaaaaaa" text="No.1 　？？？"]
[endif]
[if exp="sf.end2"]
[ptext layer="2" name="end_list" x="240" y="160" size="28" color="0x222222" text="No.2 　GOOD END　先輩と、ゴールイン"]
[else]
[ptext layer="2" name="end_list" x="240" y="160" size="28" color="0xaaaaaa" text="No.2 　？？？"]
[endif]
[if exp="sf.end3"]
[ptext layer="2" name="end_list" x="240" y="210" size="28" color="0x222222" text="No.3 　BAD END　会社、爆発"]
[else]
[ptext layer="2" name="end_list" x="240" y="210" size="28" color="0xaaaaaa" text="No.3 　？？？"]
[endif]
[if exp="sf.end4"]
[ptext layer="2" name="end_list" x="240" y="260" size="28" color="0x222222" text="No.4 　BAD END　ひとりぼっちの退職"]
[else]
[ptext layer="2" name="end_list" x="240" y="260" size="28" color="0xaaaaaa" text="No.4 　？？？"]
[endif]
[if exp="sf.end5"]
[ptext layer="2" name="end_list" x="240" y="310" size="28" color="0x222222" text="No.5 　BAD END　世界の終わりと、運用チーム"]
[else]
[ptext layer="2" name="end_list" x="240" y="310" size="28" color="0xaaaaaa" text="No.5 　？？？"]
[endif]
[if exp="sf.end6"]
[ptext layer="2" name="end_list" x="240" y="360" size="28" color="0x222222" text="No.6 　BAD END　隕石と、職務経歴書"]
[else]
[ptext layer="2" name="end_list" x="240" y="360" size="28" color="0xaaaaaa" text="No.6 　？？？"]
[endif]
[if exp="sf.end7"]
[ptext layer="2" name="end_list" x="240" y="410" size="28" color="0x222222" text="No.7 　BAD END　宇宙一、遠い夜勤"]
[else]
[ptext layer="2" name="end_list" x="240" y="410" size="28" color="0xaaaaaa" text="No.7 　？？？"]
[endif]
[if exp="sf.end8"]
[ptext layer="2" name="end_list" x="240" y="460" size="28" color="0x222222" text="No.8 　BAD END　自動ドアの、勝利"]
[else]
[ptext layer="2" name="end_list" x="240" y="460" size="28" color="0xaaaaaa" text="No.8 　？？？"]
[endif]
[if exp="sf.end9"]
[ptext layer="2" name="end_list" x="240" y="510" size="28" color="0x222222" text="No.9 　BAD END　レッドカード"]
[else]
[ptext layer="2" name="end_list" x="240" y="510" size="28" color="0xaaaaaa" text="No.9 　？？？"]
[endif]
[if exp="sf.end10"]
[ptext layer="2" name="end_list" x="240" y="560" size="28" color="0x222222" text="No.10　BAD END　オールイン"]
[else]
[ptext layer="2" name="end_list" x="240" y="560" size="28" color="0xaaaaaa" text="No.10　？？？"]
[endif]
[glink  color="black"  storage="ending/list.ks"  size="26"  x="437"  width="300"  y="620"  text="タイトルへ戻る"  target="*back"  ]
[s]

*back
[free layer="2" name="end_list"]
@jump storage="title.ks"
